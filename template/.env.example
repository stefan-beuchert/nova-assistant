# Copy to .env and fill in. Never commit the real .env file.

# Postgres connection — provisioned manually as a per-app database + user on
# the platform's shared instance. See docs/platform-assumptions.md for the
# provisioning steps. POSTGRES_HOST is the compose service name on the
# shared `atlas` network, not a hostname reachable outside Docker.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Application secrets
JWT_SECRET=

# Logging
LOG_LEVEL=info

# Public URL this service is reachable at (via reverse proxy)
APP_URL=

# Port the app listens on inside the container
PORT=8080
