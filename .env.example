# Copy to .env and fill in. Never commit the real .env file.

# Cloud reasoning model (Anthropic Claude). The one secret the PoC needs.
ANTHROPIC_API_KEY=
# Model id — the default the switcher starts on, used if unset. Defaults to Opus.
ANTHROPIC_MODEL=claude-opus-4-8
# Models offered in the UI switcher (comma-separated "id=Label"). The default
# above is always included. Unset = a built-in Opus/Sonnet/Haiku set. This only
# chooses which Claude reasons — it never changes what data Nova can reach.
# ANTHROPIC_MODELS=claude-opus-4-8=Opus 4.8,claude-sonnet-5=Sonnet 5,claude-haiku-4-5-20251001=Haiku 4.5
# Max output tokens per turn (streamed).
MAX_TOKENS=16000

# Web server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Public URL this service is reached at (via the reverse proxy).
APP_URL=https://nova.atlas
# Flask session signing key. Leave blank for an ephemeral per-boot key
# (fine for the single-user PoC); set a stable value if you want sessions
# to survive a restart.
SECRET_KEY=

# Constellation's read-only MCP server on the shared `atlas` network (Phase 3).
# This is the data source Nova reads, via the ADR-0009 allowlist. Blank = disabled
# (built-in tools only). In production on the Pi it resolves on the atlas network:
CONSTELLATION_MCP_URL=http://constellation-mcp:8000/mcp
